<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IsRestoredMonoDevelopProject>true</IsRestoredMonoDevelopProject>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>MonoDevelop.Refactoring</AssemblyName>
    <RootNamespace>MonoDevelop.Refactoring</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="glib-sharp" />
    <Reference Include="pango-sharp" />
    <Reference Include="Mono.Cairo" />
    <Reference Include="gtk-sharp" />
    <Reference Include="gdk-sharp" />
    <Reference Include="MonoDevelop.Core"><HintPath>$(RepositoryRoot)dlls\MonoDevelop.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoDevelop.Ide"><HintPath>$(RepositoryRoot)dlls\MonoDevelop.Ide.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="..\Mono.TextEditor\Mono.TextEditor.Restored.csproj" />
    <PackageReference Include="Xwt" Version="0.2.251" />
    <PackageReference Include="Mono.Addins" Version="1.3.7" />
    <PackageReference Include="ICSharpCode.NRefactory" Version="5.5.1" />
    <PackageReference Include="Mono.Debugging" Version="1.0.20170212.42" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" Condition="'$(UseRestoredMonoDevelop)' == 'true'" />
    <PackageReference Include="Mono.GtkSharp" Version="2.12.0.1" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Mono.Posix-4.5" Version="4.5.0" />
    <ProjectReference Include="..\MonoDevelop.SourceEditor2\MonoDevelop.SourceEditor2.Restored.csproj" />
    <ProjectReference Include="..\MonoDevelop.DesignerSupport\MonoDevelop.DesignerSupport.Restored.csproj" />
    <ProjectReference Include="..\MonoDevelop.Debugger\MonoDevelop.Debugger.Restored.csproj" />
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <EmbeddedResource Include="MonoDevelop.Refactoring.addin.xml"><LogicalName>MonoDevelop.Refactoring.addin.xml</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="gui.stetic"><LogicalName>gui.stetic</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="prefs-code-actions-16.png"><LogicalName>prefs-code-actions-16.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="prefs-code-actions-16-2x.png"><LogicalName>prefs-code-actions-16@2x.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="prefs-code-rules-16.png"><LogicalName>prefs-code-rules-16.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="prefs-code-rules-16-2x.png"><LogicalName>prefs-code-rules-16@2x.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="prefs-code-analysis-16.png"><LogicalName>prefs-code-analysis-16.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="prefs-code-analysis-16-2x.png"><LogicalName>prefs-code-analysis-16@2x.png</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
