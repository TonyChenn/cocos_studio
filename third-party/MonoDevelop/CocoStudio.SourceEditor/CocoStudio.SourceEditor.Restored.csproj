<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IsRestoredMonoDevelopProject>true</IsRestoredMonoDevelopProject>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>CocoStudio.SourceEditor</AssemblyName>
    <RootNamespace>CocoStudio.SourceEditor</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="gtk-sharp" />
    <Reference Include="MonoDevelop.Core"><HintPath>$(RepositoryRoot)dlls\MonoDevelop.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoDevelop.Ide"><HintPath>$(RepositoryRoot)dlls\MonoDevelop.Ide.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.TextEditor"><HintPath>$(RepositoryRoot)dlls\Mono.TextEditor.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="..\MonoDevelop.DesignerSupport\MonoDevelop.DesignerSupport.Restored.csproj" />
    <ProjectReference Include="..\MonoDevelop.SourceEditor2\MonoDevelop.SourceEditor2.Restored.csproj" />
    <ProjectReference Include="..\..\..\CocoStudio.Core\CocoStudio.Core.csproj" />
    <ProjectReference Include="..\..\..\CocoStudio.Projects\CocoStudio.Projects.csproj" />
    <ProjectReference Include="..\..\..\CocoStudio.Basic\CocoStudio.Basic.csproj" />
    <PackageReference Include="Mono.Addins" Version="1.3.7" />
    <PackageReference Include="Mono.Debugging" Version="1.0.20170212.42" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" Condition="'$(UseRestoredMonoDevelop)' == 'true'" />
    <PackageReference Include="Mono.GtkSharp" Version="2.12.0.1" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Mono.Posix-4.5" Version="4.5.0" />
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
