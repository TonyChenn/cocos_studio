<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <UseRestoredMonoDevelop Condition="'$(UseRestoredMonoDevelop)' == ''">true</UseRestoredMonoDevelop>
    <OutDir>$(RepositoryRoot)bin\$(Configuration)\</OutDir>
    <OutputPath>$(OutDir)</OutputPath>
    <BaseIntermediateOutputPath>$(RepositoryRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <ReferencePath>$(RepositoryRoot)dlls\;$(ReferencePath)</ReferencePath>
  </PropertyGroup>
</Project>
