<ExtensionModel>

  <ExtensionPoint path="/CocoStudio/Ide/ResourcePanel/Menu">
    <ExtensionNodeSet id="CocoStudio.Core.ExtensionModel.MenuSet"/>
  </ExtensionPoint>
  
  <Extension path = "/CocoStudio/Ide/ResourcePanel/Menu">
    <MenuSet id="Context" label="右键菜单">
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.NewFileCmd" isInternal="true"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.NewFolderCmd" isInternal="true"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.ImportCmd" isInternal="true"/>
      <MenuItem id="Modules.Communal.ResourcePanel.ImportFromPsd"
                label="从PSD导入"
                handler="Modules.Communal.ResourcePanel.ImportFromPsdHandler" />
      <MenuItem id="Modules.Communal.ResourcePanel.GenerateLua"
                label="生成lua"
                handler="Modules.Communal.ResourcePanel.GenerateLuaHandler" />
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.RefreshCmd" isInternal="true"/>
      <SeparatorItem id="Separator"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.CreateSerialFrameCmd" isInternal="true"/>
      <SeparatorItem id="Separator"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.DuplicateCmd" isInternal="true"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.DeleteCmd" isInternal="true"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.RenameCmd" isInternal="true"/>
      <SeparatorItem id="Separator"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.ResOpenDirCmd" isInternal="true"/>
      <SeparatorItem id="Separator"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.ProjectSettingCmd" isInternal="true"/>
    </MenuSet>

    <MenuSet id="Addition" label="+号菜单">
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.NewFileCmd" isInternal="true"/>
      <MenuItem id="CocoStudio.Core.Commands.CmdEnum.NewFolderCmd" isInternal="true"/>
    </MenuSet>
  </Extension>
  
</ExtensionModel>
