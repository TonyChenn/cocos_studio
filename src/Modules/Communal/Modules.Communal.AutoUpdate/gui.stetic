          </packing>
        </child>
        <child>
          <widget class="Gtk.Alignment" id="alignment_bottom">
            <property name="MemberName" />
            <property name="TopPadding">10</property>
            <child>
              <widget class="Gtk.HBox" id="hbox_bottom">
                <property name="MemberName" />
                <property name="Spacing">8</property>
                <child>
                  <widget class="Gtk.VBox" id="vbox_bottomLeft">
                    <property name="MemberName" />
                    <child>
                      <widget class="Gtk.Alignment" id="alignment_progressTop">
