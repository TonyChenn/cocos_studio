            <child>
              <widget class="Gtk.Alignment" id="alignment_scrolledWindows">
                <property name="MemberName" />
                <property name="LeftPadding">3</property>
                <property name="TopPadding">2</property>
                <property name="RightPadding">1</property>
                <property name="BottomPadding">2</property>
                <child>
                  <widget class="Gtk.ScrolledWindow" id="GtkScrolledWindow">
