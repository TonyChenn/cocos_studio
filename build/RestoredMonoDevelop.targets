<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'CocosStudio' or '$(IsRestoredMonoDevelopProject)' == 'true'">
    <!-- Restored projects are outside the solution list. Preserve the caller's Release/Debug configuration. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
  <!-- Source/NuGet-only since the legacy DLL cleanup; historical comments below describe earlier rollout stages. -->
  <Target Name="RejectLegacyMonoDevelopFallback" BeforeTargets="_GenerateRestoreGraphProjectEntry;Restore;BeforeClean;PrepareForBuild;CopyDllsToOutputDir">
    <Error Condition="'$(UseRestoredMonoDevelop)' != 'true'" Text="Legacy MonoDevelop fallback has been removed. Use source/NuGet builds; restore a complete Git revision to roll back." />
  </Target>
  <Target Name="RejectTestBaselineReferences" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_TestBaselineReference Include="@(ReferencePath)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ReferencePath.FullPath)', '(?i)[\\/]obj[\\/]RestoredBaseline[\\/]'))" />
    </ItemGroup>
    <Error Condition="'@(_TestBaselineReference)' != ''" Text="Production builds cannot reference test baseline assemblies: @(_TestBaselineReference)" />
  </Target>
  <!-- Historical restriction below is superseded: source builds are now the default; false retains the legacy fallback. -->
  <!-- Opt-in only: the restored libraries are not yet approved for normal editor builds. -->
  <ItemGroup Condition="'$(UseRestoredMonoDevelop)' == 'true'">
    <!-- Declare the package directly in each legacy csproj for Visual Studio NuGet restore compatibility. -->
    <Reference Include="Mono.Debugging">
      <HintPath>$(PkgMono_Debugging)\lib\net40\Mono.Debugging.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseRestoredMonoDevelop)' == 'true' and '$(MSBuildProjectName)' == 'CocosStudio'">
    <ProjectReference Include="$(RepositoryRoot)third-party\MonoDevelop\CocoStudio.LuaBinding\CocoStudio.LuaBinding.Restored.csproj">
      <Name>CocoStudio.LuaBinding.Restored</Name>
    </ProjectReference>
    <ProjectReference Include="$(RepositoryRoot)third-party\MonoDevelop\MonoDevelop.Projects.Formats.MSBuild\MonoDevelop.Projects.Formats.MSBuild.Restored.csproj">
      <Name>MonoDevelop.Projects.Formats.MSBuild.Restored</Name>
    </ProjectReference>
    <ProjectReference Include="$(RepositoryRoot)third-party\MonoDevelop\CocoStudio.WindowsPlatform\CocoStudio.WindowsPlatform.Restored.csproj">
      <Name>CocoStudio.WindowsPlatform.Restored</Name>
    </ProjectReference>
    <ProjectReference Include="$(RepositoryRoot)third-party\MonoDevelop\CocoStudio.SourceEditor\CocoStudio.SourceEditor.Restored.csproj">
      <Name>CocoStudio.SourceEditor.Restored</Name>
    </ProjectReference>
  </ItemGroup>
  <Target Name="ValidateRestoredMonoDevelop" BeforeTargets="BeforeClean;PrepareForBuild;ResolveAssemblyReferences"
          Condition="'$(UseRestoredMonoDevelop)' == 'true' or '$(IsRestoredMonoDevelopProject)' == 'true'">
    <Error Condition="'$(UseRestoredMonoDevelop)' != 'true'" Text="Legacy MonoDevelop fallback has been removed. Restore a complete Git revision to roll back." />
    <PropertyGroup Condition="'$(RestoredMonoDevelopTestBuild)' == 'true'">
      <_RestoredActualOutput>$([System.IO.Path]::GetFullPath('$(OutDir)'))</_RestoredActualOutput>
      <_RestoredExpectedOutput>$([System.IO.Path]::GetFullPath('$(RepositoryRoot)bin\RestoredMonoDevelopTest\'))</_RestoredExpectedOutput>
    </PropertyGroup>
    <Error Condition="'$(RestoredMonoDevelopTestBuild)' == 'true' and '$(_RestoredActualOutput)' != '$(_RestoredExpectedOutput)'" Text="Isolated MonoDevelop test builds must write only to bin/RestoredMonoDevelopTest/." />
    <Error Condition="!Exists('$(PkgMono_Debugging)\lib\net40\Mono.Debugging.dll')" Text="Restore Mono.Debugging 1.0.20170212.42 before building." />
    <PropertyGroup>
      <!-- The repository ReferencePath precedes HintPath. Same assembly identity is not enough to select the new API. -->
      <AssemblySearchPaths>$(PkgMono_Debugging)\lib\net40;$(AssemblySearchPaths)</AssemblySearchPaths>
    </PropertyGroup>
  </Target>
  <Target Name="ExcludeLegacyMonoDevelopCopies" BeforeTargets="_CopyFilesMarkedCopyLocal" Condition="'$(UseRestoredMonoDevelop)' == 'true'">
    <ItemGroup>
      <!-- Their source projects write to the shared test output; never copy transitive vendored versions over them. -->
      <!-- The same exclusion applies to the shared Debug/Release output after enabling source builds by default. -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'MonoDevelop.Debugger'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'MonoDevelop.SourceEditor2'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'CocoStudio.WindowsPlatform'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'CocoStudio.SourceEditor'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'CocoStudio.LuaBinding'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'MonoDevelop.DesignerSupport'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'MonoDevelop.Projects.Formats.MSBuild'))" />
    </ItemGroup>
  </Target>
</Project>
